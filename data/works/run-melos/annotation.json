  "summary": "人を信じることのできない暴君ディオニスに捕らえられた、村の牧人メロス。妹の結婚式を挙げるため、無二の友セリヌンティウスを人質に差し出し、三日目の日没までに必ず戻ると約束する――。",
  "excludedParagraphs": [74],
  "characters": [
    {"id": "melos", "judged": true, "name": "メロス", "names": ["メロス", "勇者"], "firstMention": 0, "firstOnStage": 0, "intro": "村の牧人。笛を吹き、羊と遊んで暮らしてきたが、邪悪に対しては人一倍に敏感。妹の結婚式の買い物に、シラクスの市へやって来た。"},
    {"id": "old_man", "judged": true, "name": "老爺", "names": ["老爺"], "firstMention": 0, "firstOnStage": 0, "intro": "シラクスの市の老人。あたりをはばかりながら、市が静まり返っている理由をメロスに打ち明ける。"},
    {"id": "king", "judged": true, "name": "ディオニス王", "names": ["ディオニス", "王", "暴君", "王様", "国王"], "firstMention": 0, "firstOnStage": 9, "intro": "シラクスの王。人を信じることができず、身内や臣下を次々と処刑してきた暴君。"},
    {"id": "selinuntius", "judged": true, "name": "セリヌンティウス", "names": ["セリヌンティウス", "竹馬の友", "佳き友"], "firstMention": 0, "firstOnStage": 25, "intro": "メロスの竹馬の友。シラクスの市で石工をしている。"},
    {"id": "sister", "judged": true, "name": "メロスの妹", "names": ["妹", "花嫁", "新婦"], "firstMention": 0, "firstOnStage": 26, "intro": "メロスの十六歳の妹。内気な娘で、兄と二人で暮らしている。近く結婚を控えている。"},
    {"id": "groom", "judged": true, "name": "花婿", "names": ["花婿", "婿", "亭主", "新郎"], "firstMention": 0, "firstOnStage": 31, "intro": "メロスの妹の花婿となる、村の律気な牧人。"},
    {"id": "philostratus", "judged": true, "name": "フィロストラトス", "names": ["フィロストラトス", "若い石工", "弟子"], "firstMention": 50, "firstOnStage": 50, "intro": "セリヌンティウスの弟子の、若い石工。"},
    {"id": "bandits", "judged": true, "name": "山賊", "names": ["山賊"], "firstMention": 38, "firstOnStage": 38, "intro": "峠でメロスの行く手に躍り出た、山賊の一隊。"},
    {"id": "crowd", "judged": false, "name": "群衆", "names": ["群衆"], "firstMention": 60, "firstOnStage": 60, "intro": "刑場に集まった、シラクスの市の人々。"},
